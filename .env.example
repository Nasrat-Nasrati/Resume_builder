# Host ports are deliberately non-default to coexist with other local projects.
COMPOSE_PROJECT_NAME=kabulcv
FRONTEND_PORT=53000
BACKEND_PORT=58000
POSTGRES_PORT=55432
REDIS_PORT=56379

POSTGRES_DB=kabulcv
POSTGRES_USER=kabulcv
POSTGRES_PASSWORD=change-me-for-local-development
DATABASE_URL=postgresql://kabulcv:kabulcv-local-only@db:5432/kabulcv
REDIS_URL=redis://redis:6379/0
CACHE_URL=redis://redis:6379/1

DJANGO_SECRET_KEY=replace-with-a-long-random-local-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:53000
CSRF_TRUSTED_ORIGINS=http://localhost:53000
PUBLIC_APP_URL=http://localhost:53000
VITE_API_BASE_URL=http://localhost:58000/api/v1
TIME_ZONE=Asia/Kabul

# Development mail is captured by the local Mailpit service; production SMTP values belong in deployment secrets.
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=0
DEFAULT_FROM_EMAIL=KabulCV <noreply@kabulcv.local>
MAILPIT_UI_PORT=58025

# Limit concurrent Chromium renders per worker container.
CELERY_WORKER_CONCURRENCY=1

# Payment launch gate. Do not enable until merchant/provider integration and review are complete.
PAYMENTS_ENABLED=0
PAYMENT_MERCHANT_APPROVED=0
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# Leave blank until genuine support channels are approved and monitored.
SUPPORT_EMAIL=
SUPPORT_WHATSAPP_URL=
SUPPORT_TELEGRAM_URL=
SUPPORT_OFFICE_ADDRESS=
